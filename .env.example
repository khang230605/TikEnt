# ============================================================
# .env.example – TickEnt Root
# Hướng dẫn: Copy file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI không đặt credentials thật vào file này!
# ============================================================

# --- PostgreSQL (Supabase hoặc DB khác) ---
# Transaction-mode pooler (dùng cho app runtime)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:6543/DB_NAME?pgbouncer=true&sslmode=require"

# Session-mode pooler (dùng cho migrations / schema changes)
DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME"

# --- RabbitMQ ---
# Lấy URL từ CloudAMQP (https://www.cloudamqp.com/) hoặc broker tự host.
# Dạng: amqps://user:password@host/vhost
RABBITMQ_URL="amqps://your_user:your_password@your_host.rmq.cloudamqp.com/your_vhost"

# --- JWT ---
# Tối thiểu 32 ký tự ngẫu nhiên. Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_32_plus_char_secret_string

# --- Booking ---
BOOKING_HOLD_MINUTES=10

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# --- QR Code ---
QR_BASE_URL=https://qr.yourdomain.com/verify

# --- API Gateway: Service URLs ---
# Local dev: dùng localhost. Render.com: dùng URL nội bộ (Internal URL).
EVENT_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3001
USER_PAYMENT_SERVICE_URL=http://localhost:3003

# --- CORS (API Gateway) ---
# Local dev: * (cho phép tất cả). Production: điền domain frontend cụ thể.
# Nhiều domain: phân cách bằng dấu phẩy. VD: https://app.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=*

# --- Rate Limiting (API Gateway) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
