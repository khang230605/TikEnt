# ============================================================
# .env.example – TickEnt Root (dùng bởi docker-compose.yml)
# Copy file này thành .env và điền giá trị thật trước khi chạy.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=tickent
POSTGRES_USER=tickent_user
POSTGRES_PASSWORD=your_strong_db_password_here

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# --- JWT (dùng chung cho tất cả services) ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# --- Booking ---
BOOKING_HOLD_MINUTES=10

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=noreply@tickent.io

# --- QR Code ---
QR_BASE_URL=https://qr.tickent.io/verify

# --- Rate Limiting (API Gateway) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
