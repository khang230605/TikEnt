# ============================================================
# .env.example – TickEnt API Gateway (Port: 8080)
# ============================================================
PORT=8080
NODE_ENV=development

# --- Service Target URLs ---
# Khi chạy local: dùng localhost
# Khi chạy trong Docker: dùng service name (đã config trong docker-compose.yml)
BOOKING_SERVICE_URL=http://localhost:3001
EVENT_SERVICE_URL=http://localhost:3002
USER_PAYMENT_SERVICE_URL=http://localhost:3003

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
