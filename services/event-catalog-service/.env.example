# ============================================================
# .env.example – TickEnt Event Catalog Service (Port: 3002)
# ============================================================
PORT=3002
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://tickent_user:your_db_password@localhost:5432/tickent
# Hoặc tách biến riêng:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickent
DB_USER=tickent_user
DB_PASSWORD=your_db_password
DB_POOL_MAX=10

# --- JWT (phải trùng SECRET với user-payment-service) ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
