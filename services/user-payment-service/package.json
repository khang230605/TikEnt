{
  "name": "tickent-user-payment-service",
  "version": "1.0.0",
  "description": "TickEnt User & Payment Service – Auth JWT, Webhook thanh toán, Notification Email",
  "main": "src/server.js",
  "scripts": {
    "start": "concurrently --kill-others-on-fail -n API,NOTIFY -c cyan,magenta \"node src/server.js\" \"node src/consumer/notificationConsumer.js\"",
    "dev": "nodemon src/server.js",
    "consumer:notification": "node src/consumer/notificationConsumer.js"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "concurrently": "^10.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
