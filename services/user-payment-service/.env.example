# ============================================================
# .env.example – TickEnt User Payment Service (Port: 3003)
# ============================================================
PORT=3003
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://tickent_user:your_db_password@localhost:5432/tickent
# Hoặc tách biến riêng:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickent
DB_USER=tickent_user
DB_PASSWORD=your_db_password
DB_POOL_MAX=10

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_RECONNECT_DELAY_MS=5000

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# --- Webhook Security ---
# TODO: Thay bằng secret key thật từ VNPay / Momo Dashboard
VNPAY_WEBHOOK_SECRET=your_vnpay_secret_here

# --- Email (SendGrid) ---
# TODO: Thay bằng API key thật khi deploy production
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=noreply@tickent.io

# --- QR Code ---
QR_BASE_URL=https://qr.tickent.io/verify
