# ============================================================
# .env.example – TickEnt Booking Service (Port: 3001)
# ============================================================
PORT=3001
NODE_ENV=development

# --- Database ---
# Khi chạy local: dùng connection string đầy đủ
DATABASE_URL=postgresql://tickent_user:your_db_password@localhost:5432/tickent
# Hoặc tách biến riêng:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickent
DB_USER=tickent_user
DB_PASSWORD=your_db_password
DB_POOL_MAX=10

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_RECONNECT_DELAY_MS=5000

# --- Booking Config ---
BOOKING_HOLD_MINUTES=10
